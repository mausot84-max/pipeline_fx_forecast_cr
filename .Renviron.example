# ============================================================
# pipeline_fx_forecast_cr — Environment Variables (TEMPLATE)
# ============================================================
# Este archivo es un TEMPLATE. NUNCA coloques credenciales reales acá
# ni lo commitees al repositorio público con valores reales.
#
# Para usar el pipeline:
#   1. Copiar este archivo a .Renviron en la raíz del proyecto:
#        cp .Renviron.example .Renviron
#   2. Editar .Renviron y reemplazar los placeholders YOUR_*
#      por tus credenciales propias.
#   3. .Renviron está incluido en .gitignore — NO se commitea.
#   4. Reiniciar R (Ctrl+Shift+F10) para que las variables se carguen.
# ============================================================

# --- BCCR SDDE API (portal nuevo, token JWT) ------------------
# Obtener el token en: https://sdd.bccr.fi.cr
# Mi Perfil -> "Generar token" -> "Copiar token"
# El JWT es una cadena larga que empieza con "eyJ..."
BCCR_EMAIL=YOUR_EMAIL@example.com
BCCR_TOKEN=YOUR_BCCR_JWT_TOKEN_HERE

# --- FRED API (Federal Reserve Economic Data) -----------------
# Obtener el key en: https://fred.stlouisfed.org/docs/api/api_key.html
# Sólo requerido para los scripts de forecasting semanal (scripts/01-19).
# Los scripts de la pinza empírica (cierre_v6/) NO requieren FRED.
FRED_API_KEY=YOUR_FRED_API_KEY_HERE
